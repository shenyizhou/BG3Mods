    <content contentuid="h7f5ef778g82f7g406dga911g120d11972688" version="1">Gain +30 on all skill checks/throws.</content>
    <content contentuid="hb433cc9cg43d3g431aga861ga9b43b0bb401" version="1">Succeeding</content>
    <content contentuid="hc4a8566cgedc1g4753gbd97g4ba2bd814ca8" version="1">You have +30 to all rolls.</content>

    <content contentuid="h346a965bg9cdcg4cdagb5dbg9dbffe5573b9" version="1">Force Crit Rolls +1</content>
    <content contentuid="h86b968a6g5e96g4091g9964ge9cae41f6e1d" version="1">Success is always an option, the only option.</content>
