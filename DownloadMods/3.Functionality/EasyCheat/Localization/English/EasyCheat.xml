    <content contentuid="he5b7a72cgea53g4d1aga490g8177e9cf305b" version="1">Nat 20, let's go.</content>

    <content contentuid="h7950d9d2g6139g469cgaa38gd45c13da1e95" version="1">Fail Rolls</content>
    <content contentuid="he2eaf2a4g6dc8g40eag89dag0126cce4e401" version="1">Gain advantage... but -50 on all skill checks/throws.</content>
