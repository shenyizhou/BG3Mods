<?xml version="1.0" encoding="UTF-8"?>
<!--
  KungFuMaster 进展描述配置文件
  定义武侠子职业和各种武功门类的显示名称、描述和选择器ID
  用于角色创建和升级时的界面显示
-->
<save>
    <!-- 文件格式版本信息 -->
    <version major="4" minor="0" revision="9" build="319"/>
    <!-- 进展描述区域：包含所有进展选项的描述信息 -->
    <region id="ProgressionDescriptions">
        <node id="root">
            <children>
                <!-- 武侠子职业：武侠职业的子职业 -->
                <node id="ProgressionDescription">
                    <!-- 子职业描述：武功修炼的详细说明 -->
                    <attribute id="Description" type="TranslatedString" handle="he84d54b6g3bd0g4693g9cb3g148897371853" version="1"/>
                    <!-- 子职业显示名称：武侠 -->
                    <attribute id="DisplayName" type="TranslatedString" handle="hf9ae34c1g23a1g4db9gb0dbg53aaf95eef82" version="1"/>
                    <!-- 子职业类型标识符 -->
                    <attribute id="Type" type="FixedString" value="KungFuMaster"/>
                    <!-- 关联的进展表ID -->
                    <attribute id="ProgressionTableId" type="guid" value="f7d159e6-c3c3-4b61-93e9-f934bdfa293a"/>
                    <!-- 子职业唯一标识符 -->
                    <attribute id="UUID" type="guid" value="28d84fd0-fe62-488a-ab59-e430e9c83190"/>
                </node>
                <!-- 硬功门类：刚猛外功修炼 -->
                <node id="ProgressionDescription">
                    <!-- 硬功描述：刚猛武功的修炼方法 -->
