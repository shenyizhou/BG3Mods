local __util = require 'larian.util'

-- 基础等级判断函数
function IsLevelHigherThen(number)
	if GetModifier(context.Source.Level) >= number then
		return ConditionResult(true)
	end
	return ConditionResult(false)
end

-- 检查是否拥有特定武功
function HasKungFuPassive(passiveName)
	if HasPassive(context.Source, passiveName) then
		return ConditionResult(true)
	end
	return ConditionResult(false)
end

-- 检查是否有足够的气力骰子
function HasEnoughSuperiorityDice(requiredPoints)
	local currentDice = GetActionResourceValueCap(context.Source, "SuperiorityDice", 0)
	if currentDice >= requiredPoints then
		return ConditionResult(true)
	end
	return ConditionResult(false)
end

-- 检查武功组合效果
function HasKungFuCombo(passive1, passive2)
	if HasPassive(context.Source, passive1) and HasPassive(context.Source, passive2) then
		return ConditionResult(true)
	end
	return ConditionResult(false)
end

-- 计算武功熟练度加成
function GetKungFuMasteryBonus()
	local level = GetModifier(context.Source.Level)
	local bonus = math.floor(level / 4) + 1
	return bonus
end

-- 检查是否在战斗中
function IsInCombat()
	if context.Source.Combat ~= nil then
		return ConditionResult(true)
	end
	return ConditionResult(false)
end

-- 检查生命值百分比
function GetHealthPercentage()
	local currentHP = GetModifier(context.Source.HP)
	local maxHP = GetModifier(context.Source.MaxHP)
	if maxHP > 0 then
		return (currentHP / maxHP) * 100
	end
	return 0
end

-- 检查是否处于低血量状态
function IsLowHealth(threshold)
	local healthPercent = GetHealthPercentage()
	if healthPercent <= (threshold or 25) then
		return ConditionResult(true)
	end
	return ConditionResult(false)
end

-- 检查武功类型数量
function GetKungFuTypeCount()
	local count = 0
	local kungfuTypes = {
		"Passive_KungFuMaster_HuangDiNeiJing", "Passive_KungFuMaster_ShenZhaoJing", -- 医药
		"Passive_KungFuMaster_JinGangBuHuaiShenGong", "Passive_KungFuMaster_DaJinGangShenLi", -- 硬功
		"Passive_KungFuMaster_MingMuGong", "Passive_KungFuMaster_ShenJiBaiBian", "Passive_KungFuMaster_ZuoYouShouHuBoShu", -- 软功
		"Passive_KungFuMaster_TiYunZong", "Passive_KungFuMaster_YiWeiDuJiang", "Passive_KungFuMaster_LingBoWeiBu", "Passive_KungFuMaster_FeiXuQingYanGong", -- 轻功
		"Passive_KungFuMaster_YiJinJing", "Passive_KungFuMaster_XiSuiJing", "Passive_KungFuMaster_TianCanGong", "Passive_KungFuMaster_BuSiYinFa", "Passive_KungFuMaster_TaiXuanJing", -- 内功
		"Passive_KungFuMaster_WuLeiTianXinJue", -- 外功
		"Passive_KungFuMaster_TaiJiQuan", "Passive_KungFuMaster_DouZhuanXingYi", "Passive_KungFuMaster_QianKunDaNuoYi" -- 拆招
	}

	for _, passive in ipairs(kungfuTypes) do
		if HasPassive(context.Source, passive) then
			count = count + 1
		end
	end

	return count
end

-- 检查是否达到武功大师级别
function IsKungFuMaster()
	local level = GetModifier(context.Source.Level)
	local kungfuCount = GetKungFuTypeCount()
	if level >= 10 and kungfuCount >= 5 then
		return ConditionResult(true)
	end
	return ConditionResult(false)
end