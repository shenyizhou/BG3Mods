<?xml version="1.0" encoding="UTF-8"?>
<!-- 武侠职业进展配置文件 -->
<!-- 定义KungFuMonk职业1-20级的能力提升和资源获得 -->
<save>
	<version major="4" minor="0" revision="9" build="330" />
	<region id="Progressions">
		<node id="root">
			<children>

				<!-- 武侠1级进展：基础武功入门 -->
				<node id="Progression">
					<!-- 移除重甲熟练度，符合武僧标准，初始2点气 -->
					<attribute id="Boosts" type="LSString" value="ActionResource(KiPoint,2,0)" />
					<attribute id="Level" type="uint8" value="1" />
					<attribute id="Name" type="LSString" value="KungFuMonk" />
					<!-- 进展类型：0表示主职业进展 -->
					<attribute id="ProgressionType" type="uint8" value="0" />
					<!-- 选择器：可选择四大武功门类各一项 -->
					<!-- NeiGong(内功), WaiGong(外功), QingGong(轻功), YingGong(硬功) -->
					<attribute id="Selectors" type="LSString" value="SelectPassives(01bef723-3a92-4640-811d-4c57df429712,1,NeiGong);SelectPassives(556ab3de-5af7-4e11-9b08-48764ae60b46,1,WaiGong);SelectPassives(d9eff3c2-0fa4-4022-9ce3-d684c6d3fa29,1,QingGong);SelectPassives(5457b361-7306-469d-9032-6f2760a629e3,1,YingGong)" />
					<!-- 关联的进展表UUID -->
					<attribute id="TableUUID" type="guid" value="f7d159e6-c3c3-4b61-93e9-f934bdfa293a" />
					<!-- 此进展节点的唯一标识符 -->
					<attribute id="UUID" type="guid" value="30cbcb19-25ff-488c-aa42-a81e519411a3" />
				</node>
				<!-- 武功僧侣2级进展：内力增长 -->
				<node id="Progression">
					<!-- 2级专注内力修炼，增加1点气 -->
					<attribute id="Boosts" type="LSString" value="ActionResource(KiPoint,1,0)" />
					<attribute id="Level" type="uint8" value="2" />
					<attribute id="Name" type="LSString" value="KungFuMonk" />
					<attribute id="ProgressionType" type="uint8" value="0" />
					<attribute id="TableUUID" type="guid" value="f7d159e6-c3c3-4b61-93e9-f934bdfa293a" />
					<attribute id="UUID" type="guid" value="bce69ae4-18ac-41d5-a71c-41bec8bfcfd6" />
				</node>
				<!-- 标准武僧3级进展：子职业选择 -->
				<node id="Progression">
					<!-- 3级标准武僧进展，增加1点气，添加偏斜飞弹 -->
					<attribute id="Boosts" type="LSString" value="ActionResource(KiPoint,1,0);ActionResource(DeflectMissiles_Charge,1,0)" />
					<attribute id="Level" type="uint8" value="3" />
					<attribute id="Name" type="LSString" value="KungFuMonk" />
					<attribute id="PassivesAdded" type="LSString" value="DeflectMissiles" />
					<attribute id="ProgressionType" type="uint8" value="0" />
					<attribute id="TableUUID" type="guid" value="f7d159e6-c3c3-4b61-93e9-f934bdfa293a" />
					<attribute id="UUID" type="guid" value="a0d47f19-6f8b-4e9d-a644-3d47c4e55157" />
					<children>
						<node id="SubClasses">
							<children>
								<node id="SubClass">
									<attribute id="Object" type="guid" value="30cbcb19-25ff-488c-aa42-a81e519411a3" />
								</node>
							</children>
						</node>
					</children>
				</node>
				<!-- 武侠子职业3级进展：武功精进 -->
				<node id="Progression">
					<!-- 3级可选择额外武功技能，增加1点气 -->
					<attribute id="Boosts" type="LSString" value="ActionResource(KiPoint,1,0)" />
					<attribute id="Level" type="uint8" value="3" />
					<attribute id="Name" type="LSString" value="KungFuMonk" />
					<attribute id="ProgressionType" type="uint8" value="1" />
					<!-- 可再次选择四大武功门类技能 -->
					<attribute id="Selectors" type="LSString" value="SelectPassives(01bef723-3a92-4640-811d-4c57df429712,1,NeiGong);SelectPassives(556ab3de-5af7-4e11-9b08-48764ae60b46,1,WaiGong);SelectPassives(d9eff3c2-0fa4-4022-9ce3-d684c6d3fa29,1,QingGong);SelectPassives(5457b361-7306-469d-9032-6f2760a629e3,1,YingGong)" />
