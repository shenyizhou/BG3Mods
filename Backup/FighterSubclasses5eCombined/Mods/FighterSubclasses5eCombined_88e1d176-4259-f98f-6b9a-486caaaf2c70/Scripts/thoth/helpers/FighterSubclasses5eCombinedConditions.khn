local __util = require 'larian.util'

function AASourceSpellWeaponAttackDC(fallbackDC, entity, ability)
    local entity = entity or context.Source
	local spellDC = fallbackDC or 10 -- Global default so that we don't return 0
    local ability = ability or context.PreferredCastingAbility
	if entity.IsValid then
        try
		    spellDC = CalculateSpellDC(ability, entity)
        catch e then
        end
	end
	return spellDC
end

function PDKcantSpeak(entity)
	local entity = entity or context.Source
    return HasStatus('SILENCED',entity)
end

function BIs5eThrownWeaponAttack()
    local res = IsUnarmedAttack() & SpellTypeIs(SpellType.Throw) & HasWeaponProperty(WeaponProperties.Thrown, context.HitDescription.ThrownObject)
    return ConditionResult(res.Result)
end

function BClassLevelEqual(level, class, entity)
    local entity = entity or context.Source
    return ConditionResult(entity.GetClassLevel(class) == level)
end

function BruteishDurabilityCheck(dc, flatBonus, entity)
    local entity = entity or context.Target
    local dc = dc or 10
    local bonus = flatBonus or 0
	
    if HasStatus('BANE',entity).Result then
        bonus = flatBonus - Roll(1, DiceType.d4)
    end

    if HasStatus('BLESS',entity).Result then
        bonus = flatBonus + Roll(1, DiceType.d4)
    end

    local rollResult = Roll(1, DiceType.d20, bonus) + Roll(1, DiceType.d6)

    if rollResult >= dc then
        return ConditionResult(true)
    else
        return ConditionResult(false)
    end
end

function RollBrutishDurabilityCheck(dc)
	local dc = dc or 20
    local roll1 = Roll(1, DiceType.d20, 0)
	local roll2 = Roll(1, DiceType.d6, 0)

	if type(roll1) == "number" then
		if (roll1 + roll2) >= dc then
			return ConditionResult(true)
		end

    	return ConditionResult(false)
	end
    return ConditionResult(true,{},{},1)
end

function CAVStrengthGreaterThan(value, entity)
    entity = entity or context.Source
    return ConditionResult(entity.Strength > value)
end

function CAVIs5eThrownCreatureAttack()
    local res = IsUnarmedAttack() & SpellTypeIs(SpellType.Throw) & Character(context.HitDescription.ThrownObject)
    return ConditionResult(res.Result)
end

function IsUnwaveringMarkAttackTarget()
	local result = HasStatus('UNWAVERING_MARK_EXTRA_ATTACK_TARGET',context.Target,context.Source)
    return ConditionResult(result.Result, {ConditionError("IsNotUnwaveringMarkAttackTarget")})
end   

function UnwaveringMarkAttackCheck()
	return SpellId('Target_UnwaveringMarkBonusAttack') | SpellId('Target_UnwaveringMarkBonusMainMelee') | SpellId('Target_UnwaveringMarkBonusOffMelee') | SpellId('Target_UnwaveringMarkBonusUnarmed') | SpellId('Target_UnwaveringMarkBonusImprovised')
end

function CAVConstitutionGreaterThan(value, entity)
    entity = entity or context.Source
    return ConditionResult(entity.Constitution > value)
end

function CanUnwaveringMarkOffHandAttack()
	local result = WieldingWeapon('Melee',true,true,context.Source)
    return ConditionResult(result.Result, {ConditionError("HasNotOffHandMeleeWeapon")})
end   

function CanWardingManeuver()
	local result = HasShieldEquipped(context.Source) | WieldingWeapon('Melee',false,false,context.Source)
    return ConditionResult(result.Result, {ConditionError("CanNotWardingManeuver")})
end   

function HasReachFiveAbility(entity)
	local entity = entity or context.Source
	return HasStatus('RAGE_GIANT_BASE',entity) | HasStatus('RAGE_GIANT_SMALL',entity) | HasStatus('RAGE_GIANT_MEDIUM',entity)
end

function HasReachTenAbility(entity)
	local entity = entity or context.Source
	return HasStatus('RAGE_GIANT_DC_BASE',entity) | HasStatus('RAGE_GIANT_DC_SMALL',entity) | HasStatus('RAGE_GIANT_DC_MEDIUM',entity) | HasStatus('RAGE_GIANT_DC_LARGE',entity)
end

function HasAnyReachAbility(entity)
	local entity = entity or context.Source
	return HasReachFiveAbility(entity) | HasReachTenAbility(entity)
end

function IsFightingUnarmed(entity)
	local entity = entity or context.Source
	return ~WieldingWeapon('Melee',false,false,entity) & ~WieldingWeapon('Ammunition',false,false,entity)
end

function IsSameAttackRange(entity)
	local entity = entity or context.Source
	return WieldingWeapon('Melee',false,true,entity) | IsFightingUnarmed(entity)
end

function CAVIsAttackSpell()
	return HasStringInSpellRoll('WeaponAttack') | HasStringInSpellRoll('UnarmedAttack') | HasStringInSpellRoll('SpellAttack') | SpellId('Target_CommandersStrike') | SpellId('Target_UnwaveringMarkBonusAttack') | SpellId('Target_UnwaveringMarkBonusMainMelee') | SpellId('Target_UnwaveringMarkBonusOffMelee') | SpellId('Target_UnwaveringMarkBonusUnarmed') | SpellId('Target_UnwaveringMarkBonusImprovised')
end

function PWIs5eAttackWithWeaponException()
	return IsSpellAttack() | PWIs5eMeleeUnarmedAttack() | PWIs5eThrownCreatureAttack()
end

function PWIs5eMeleeUnarmedAttack()
    local res = IsMeleeUnarmedAttack() & ~SpellTypeIs(SpellType.Throw)
    return ConditionResult(res.Result)
end

function PWIs5eThrownCreatureAttack()
    local res = IsUnarmedAttack() & SpellTypeIs(SpellType.Throw) & Character(context.HitDescription.ThrownObject)
    return ConditionResult(res.Result)
end

function PWIs5eThrownWeaponAttack()
    local res = IsUnarmedAttack() & SpellTypeIs(SpellType.Throw) & HasWeaponProperty(WeaponProperties.Thrown, context.HitDescription.ThrownObject)
    return ConditionResult(res.Result)
end

function PWIsThrowSpell()
	local res = HasStringInSpellRoll('UnarmedAttack') & SpellTypeIs(SpellType.Throw)
    return ConditionResult(res.Result)
end


function HasUsedPsionicStrike()
	result = HasStatus('PSIONIC_STRIKE_USED',context.Source) & ~HasStatus('TELEKINETIC_THRUST_SKIP',context.Source)
	return ConditionResult(result.Result, {ConditionError("HasNotUsedPsionicStrike")})
end

function IsTelekineticThrustArea()
	result = ~Character(context.Target)
	return ConditionResult(result.Result, {ConditionError("IsNotTelekineticThrustArea")})
end

function IsTelekineticThrustTarget()	
	result = Character(context.Target) & HasStatus('PSIONIC_STRIKE_TARGET',context.Target)
	return ConditionResult(result.Result, {ConditionError("IsNotTelekineticThrustTarget")})
end

function TelekineticMasterSpellCheck()
    return HasStringInSpellRoll('WeaponAttack') | PWIsThrowSpell() 
end

function TelekineticMasterCheck()
    return TelekineticMasterSpellCheck()
end

function IsCloudRedirectTarget()
	result = ~HasStatus('CLOUD_RUNE_SOURCE',context.Target,context.Source) & HasStatus('CLOUD_RUNE_POSSIBLE_TARGET',context.Target,context.Source) & SRDCanSee(context.Source,context.Target)
	return ConditionResult(result.Result, {ConditionError("IsNotValidCloudRuneTarget")})
end



function RKMeleeAttackSpellCheck()
    return HasStringInSpellRoll('MeleeWeaponAttack') | HasStringInSpellRoll('MeleeOffHandWeaponAttack') | HasStringInSpellRoll('MeleeUnarmedAttack') | HasStringInSpellRoll('MeleeSpellAttack') | HasStringInSpellRoll('ShoveCheck') | SpellId('Target_Grapple') | SpellId('Target_ReleaseGrapple') | SpellId('Throw_Carry')
end

function RKReachAttackCheck()
    return RKMeleeAttackSpellCheck() & ~TargetRadiusGreaterThan(1.5) & ~SpellId('Target_BoomingBlade') & ~SpellId('Target_GreenFlameBlade')
end

function RKSizeEqual(size, entity)
    entity = entity or context.Source
    return ConditionResult(entity.Size ~= Size.None and entity.Size.value == size.value)
end

function RKSizeEqualOrGreater(size, entity)
    entity = entity or context.Source
    return ConditionResult(entity.Size ~= Size.None and entity.Size.value >= size.value)
end

function RKIs5eWeaponAttack()
    return IsMeleeWeaponAttack() | IsRangedWeaponAttack() | IsMeleeUnarmedAttack() | IsRangedUnarmedAttack()
end

function RKIs5eThrownCreatureAttack()
    local res = IsUnarmedAttack() & SpellTypeIs(SpellType.Throw) & Character(context.HitDescription.ThrownObject)
    return ConditionResult(res.Result)
end

function RKIs5eThrownWeaponAttack()
    local res = IsUnarmedAttack() & SpellTypeIs(SpellType.Throw) & HasWeaponProperty(WeaponProperties.Thrown, context.HitDescription.ThrownObject)
    return ConditionResult(res.Result)
end

function RKIs5eAttackWithWeaponException()
	return IsSpellAttack() | RKIs5eMeleeUnarmedAttack() | RKIs5eThrownCreatureAttack()
end

function RKIs5eMeleeUnarmedAttack()
    local res = IsMeleeUnarmedAttack() & ~SpellTypeIs(SpellType.Throw)
    return ConditionResult(res.Result)
end

function SamIs5eWeaponAttack()
    return IsMeleeWeaponAttack() | IsRangedWeaponAttack() | IsMeleeUnarmedAttack() | IsRangedUnarmedAttack()
end

function SamIs5eThrownCreatureAttack()
    local res = IsUnarmedAttack() & SpellTypeIs(SpellType.Throw) & Character(context.HitDescription.ThrownObject)
    return ConditionResult(res.Result)
end

function SamIs5eWeaponAttackException()
		return IsSpellAttack() | Is5eThrownCreatureAttack()
end


function SamIs5eAttackRoll()
	return HasStringInSpellRoll('WeaponAttack') | HasStringInSpellRoll('UnarmedAttack') | HasStringInSpellRoll('SpellAttack')
end

function SamIs5eWeaponAttackRoll()
	return HasStringInSpellRoll('WeaponAttack') | HasStringInSpellRoll('UnarmedAttack') 
end

function SamIs5eAttackActionRoll()
	return SamIs5eWeaponAttackRoll() | HasStringInSpellRoll('Shove') | SpellId('Target_Grapple')
end

function IsSamExtraAttack()
	return SpellId('Sam_Target_MainHandAttack') | SpellId('Sam_Projectile_MainHandAttack') | SpellId('Sam_Target_UnarmedAttack') | SpellId('Sam_Throw_Throw') | SpellId('Sam_Throw_ImprovisedWeapon') 
end	

function IsSamLethalHP(value, entity)
	entity = entity or context.Target
	value = value or 1
	
	if (entity.HP - entity.TemporaryHP) > value then
		return ConditionResult(false)
	end
	
	return ConditionResult(true)
end
	
function RapidStrikeSAMExtraAttackSpellCheck()
    return (HasStringInSpellRoll('WeaponAttack') | HasStringInSpellRoll('UnarmedAttack')) & ~HasStringInSpellRoll('ShoveCheck') & ~SpellId('Target_Grapple')
end

function RapidStrikeSAMExtraAttackCheck()
    return RapidStrikeSAMExtraAttackSpellCheck() & HasUseCosts('ActionPoint',false)
end

function SRDHasAllyWithinRange(inclusionStatus, distance, tag, target, source)
    distance = distance or 1.5
    target = target or context.Target
    source = source or context.Source

    local errorTrue = {ConditionError("HasAllyWithinRange", {ConditionErrorData.MakeFromNumber(distance, EErrorDataType.Distance)})}
    local errorFalse = {ConditionError("HasNotAllyWithinRange", {ConditionErrorData.MakeFromNumber(distance, EErrorDataType.Distance)})}

    local allies = GetAlliesWithinRange(distance, target, source)
    if allies ~= nil then
        for _, entity in ipairs(allies.Allies) do
            -- ensure entity has the included status
            local noIncludedStatus = ConditionResult(inclusionStatus == nil)
            if inclusionStatus then
                noIncludedStatus = HasStatus(inclusionStatus, entity)
            end

            -- filter by tag if provided
            local hasTag = ConditionResult(tag == nil)
            if tag then
                hasTag = Tagged(tag, entity)
            end

            if noIncludedStatus.Result and hasTag.Result then
                return ConditionResult(true, errorFalse, errorTrue)
            end
        end
    end

    return ConditionResult(false, errorFalse, errorTrue)
end

function SRDHasEnemyWithinRange(inclusionStatus, distance, tag, NumberOfEnemy, target, source)
    distance = distance or 1.5
    NumberOfEnemy = NumberOfEnemy or 1
    target = target or context.Target
    source = source or context.Source

    local errorTrue = {ConditionError("HasAllyWithinRange", {ConditionErrorData.MakeFromNumber(distance, EErrorDataType.Distance)})}
    local errorFalse = {ConditionError("HasNotAllyWithinRange", {ConditionErrorData.MakeFromNumber(distance, EErrorDataType.Distance)})}

    local enemies = GetEnemiesWithinRange(distance, target, source)
    if enemies ~= nil then
        -- Only do the check when we are surounded by more than or equal the NumberOfEnemy
        if #enemies.Enemies >= NumberOfEnemy then
            for _, entity in ipairs(enemies.Enemies) do
                -- ensure entity has the included status
                local noIncludedStatus = ConditionResult(inclusionStatus == nil)
                if inclusionStatus then
                    noIncludedStatus = HasStatus(inclusionStatus, entity)
                end

                -- filter by tag if provided
                local hasTag = ConditionResult(tag == nil)
                if tag then
                    hasTag = Tagged(tag, entity)
                end

                if noIncludedStatus.Result and hasTag.Result then
                    return ConditionResult(true, errorFalse, errorTrue)
                end
            end
        end
    end
    return ConditionResult(false, errorFalse, errorTrue)
end

function SRDCanSee(source, target, from, to)
	local source = source or context.Source
	local target = target or context.Target
    local from = from or context.SourcePosition
    local to = to or context.Target	
		
	return CanSee(source, target) | SRDCanSeeSneaking(source, target, from, to) | SRDCanSeeInvisible(source, target, from, to) | SRDCanSeeBlinded(source, target, from, to) 
end

function SRDCanSeeSneaking(source, target, from, to)
    local source = source or context.Source
    local target = target or context.Target
    local from = from or context.SourcePosition
    local to = to or context.Target
    
    return HasStatus('SNEAKING', target) & (HasStatus('MIND_SPIKE_OWNER', source) & HasStatus('MIND_SPIKE', target, source))
end

function SRDCanSeeInvisible(source, target, from, to)
	local source = source or context.Source
	local target = target or context.Target
    local from = from or context.SourcePosition
    local to = to or context.Target	
	
    return Tagged('BLINDSIGHT', source) 
       |  (HasStatus('MIND_SPIKE_OWNER', source) & HasStatus('MIND_SPIKE', target, source))
       |  (HasStatus('TRUESIGHT', source) & ~DistanceToEntityGreaterThan(36.5, from, to))
       | ((HasStatus('SEE_INVISIBILITY', source) | HasStatus('MAG_SEE_INVISIBILITY_HIDDEN_IGNORE_RESTING', source) | HasPassive('AllSeeingEye', source)) & ~DistanceToEntityGreaterThan(18.5, from, to)) 
       | ((HasPassive('FightingStyle_BlindFighting', source) | (HasPassive('Blindsense', source) & ~(HasPassive('Deafness',source) | HasStatus('SG_Deafened',source)))) & ~DistanceToEntityGreaterThan(3, from, to))	
end	

function SRDCanSeeBlinded(source, target, from, to)
    local source = source or context.Source
    local target = target or context.Target
    local from = from or context.SourcePosition
    local to = to or context.Target	

    return HasStatus('SG_Blinded', source) & (Tagged('BLINDSIGHT', source) 
       |  (HasStatus('MIND_SPIKE_OWNER', source) & HasStatus('MIND_SPIKE', target, source))
       |  (HasStatus('TRUESIGHT', source) & ~DistanceToEntityGreaterThan(36.5, from, to)) 
       | ((HasStatus('SEE_INVISIBILITY', source) | HasStatus('MAG_SEE_INVISIBILITY_HIDDEN_IGNORE_RESTING', source) | HasPassive('AllSeeingEye', source)) & ~DistanceToEntityGreaterThan(18.5, from, to)) 
       | ((HasPassive('FightingStyle_BlindFighting', source) | (HasPassive('Blindsense', source) & ~(HasPassive('Deafness',source) | HasStatus('SG_Deafened',source)))) & ~DistanceToEntityGreaterThan(3, from, to)))
end

function IsSteadyAim(light)
    local checkLightWeapon = light or false
	
	if checkLightWeapon then
		return (WieldingWeapon('Ammunition', false, false, context.Source) | WieldingWeapon('Ammunition', true, false, context.Source)) & IsRangedWeaponAttack() & HasWeaponProperty(WeaponProperties.Light,GetAttackWeapon(context.Source)) & ~DistanceToTargetGreaterThan(15) & HasStatus('STEADY_AIM_SS_TARGET',context.Target,context.Source) & HasStatus('STEADY_AIM_SS_WEAPON',GetAttackWeapon(context.Source),context.Source)
    else
		return (WieldingWeapon('Ammunition', false, false, context.Source) | WieldingWeapon('Ammunition', true, false, context.Source)) & IsRangedWeaponAttack() & ~HasWeaponProperty(WeaponProperties.Light,GetAttackWeapon(context.Source)) & ~DistanceToTargetGreaterThan(18) & HasStatus('STEADY_AIM_SS_TARGET',context.Target,context.Source) & HasStatus('STEADY_AIM_SS_WEAPON',GetAttackWeapon(context.Source),context.Source)
    end
end

function SnapShotSpellCheck()
    return HasStringInSpellRoll('RangedWeaponAttack') | HasStringInSpellRoll('RangedUnarmedAttack') | HasStringInSpellRoll('ThrowAttack') | SpellId('Projectile_ArrowOfSmokepowder')
end

function SnapShotCheck()
    return SnapShotSpellCheck() & HasUseCosts('ActionPoint',false)
end

function CanRapidStrikeOffHand(entity)
	local entity = entity or context.Observer
	return IsOffHandAttack() & HasActionResource('BonusActionPoint',2,0,false,false,entity)
end