<?xml version="1.0" encoding="utf-8"?>
<!--
  KungFuMaster 模组元数据配置文件
  定义模组的基本信息、版本、依赖关系和目标模式
  这是博德之门3模组系统识别和加载模组的核心文件
-->
<save>
  <!-- 模组文件格式版本信息 -->
  <version major="4" minor="0" revision="0" build="49" />
  <!-- 配置区域：包含模组的所有配置信息 -->
  <region id="Config">
    <node id="root">
      <children>
        <!-- 依赖项节点：定义模组依赖的其他模组（当前为空） -->
        <node id="Dependencies" />
        <!-- 模组信息节点：包含模组的详细元数据 -->
        <node id="ModuleInfo">
          <!-- 模组作者 -->
          <attribute id="Author" type="LSWString" value="沈浪" />
          <!-- 角色创建关卡名称（未使用） -->
          <attribute id="CharacterCreationLevelName" type="FixedString" value="" />
          <!-- 模组描述：武侠增强版 -->
          <attribute id="Description" type="LSWString" value="武僧武侠子职业" />
          <!-- 模组文件夹名称 -->
          <attribute id="Folder" type="LSWString" value="KungFuMaster" />
          <!-- GM模板（未使用） -->
          <attribute id="GMTemplate" type="FixedString" value="" />
          <!-- 大厅关卡名称（未使用） -->
          <attribute id="LobbyLevelName" type="FixedString" value="" />
          <!-- 文件MD5校验值（自动生成） -->
          <attribute id="MD5" type="LSString" value="" />
          <!-- 主菜单背景视频（未使用） -->
          <attribute id="MainMenuBackgroundVideo" type="FixedString" value="" />
          <!-- 菜单关卡名称（未使用） -->
          <attribute id="MenuLevelName" type="FixedString" value="" />
          <!-- 模组内部名称标识符 -->
          <attribute id="Name" type="FixedString" value="KungFuMaster" />
          <!-- 支持的玩家数量 -->
          <attribute id="NumPlayers" type="uint8" value="4" />
          <!-- 拍照亭设置（未使用） -->
          <attribute id="PhotoBooth" type="FixedString" value="" />
          <!-- 启动关卡名称（未使用） -->
          <attribute id="StartupLevelName" type="FixedString" value="" />
          <!-- 模组标签（未使用） -->
          <attribute id="Tags" type="LSWString" value="" />
          <!-- 模组类型：附加组件 -->
          <attribute id="Type" type="FixedString" value="Add-on" />
          <!-- 模组唯一标识符UUID -->
          <attribute id="UUID" type="FixedString" value="3f2cefd2-880c-4d83-a4cf-8c0d96dd889a" />
          <!-- 模组版本号（64位整数格式） -->
          <attribute id="Version64" type="int64" value="144115188075855884" />
          <children>
            <!-- 发布版本信息 -->
            <node id="PublishVersion">
              <!-- 发布版本号（与主版本号相同） -->
              <attribute id="Version64" type="int64" value="144115188075855884" />
            </node>
            <!-- 脚本节点（当前未使用脚本） -->
            <node id="Scripts" />
            <!-- 目标模式：定义模组适用的游戏模式 -->
            <node id="TargetModes">
              <children>
                <!-- 目标：故事模式（主要游戏模式） -->
                <node id="Target">
                  <attribute id="Object" type="FixedString" value="Story" />
                </node>
              </children>
            </node>
          </children>
        </node>
      </children>
    </node>
  </region>
</save>