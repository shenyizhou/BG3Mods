<?xml version="1.0" encoding="UTF-8"?>
<!-- 武侠子职业进展配置文件 -->
<!-- 定义KungFuMaster子职业的特有能力和武功技能 -->
<save>
	<version major="4" minor="0" revision="9" build="330" />
	<region id="Progressions">
		<node id="root">
			<children>
				<!-- 武侠3级进展：基础武功入门 + 6个气力骰子 -->
				<node id="Progression">
					<!-- 3级可选择额外武功技能 + 获得6个气力骰子 -->
					<attribute id="Boosts" type="LSString" value="ActionResourceMultiplier(SuperiorityDice,6,0)" />
					<attribute id="Level" type="uint8" value="3" />
					<attribute id="Name" type="LSString" value="KungFuMaster" />
					<attribute id="ProgressionType" type="uint8" value="1" />
					<!-- 选择器：可选择四大武功门类各一项 -->
					<!-- YingGong(硬功), QingGong(轻功), NeiGong(内功), WaiGong(外功) -->
					<attribute id="Selectors" type="LSString" value="SelectPassives(5457b361-7306-469d-9032-6f2760a629e3,1,YingGong);SelectPassives(d9eff3c2-0fa4-4022-9ce3-d684c6d3fa29,1,QingGong);SelectPassives(01bef723-3a92-4640-811d-4c57df429712,1,NeiGong);SelectPassives(556ab3de-5af7-4e11-9b08-48764ae60b46,1,WaiGong)" />
					<attribute id="TableUUID" type="guid" value="f7d159e6-c3c3-4b61-93e9-f934bdfa293a" />
					<attribute id="UUID" type="guid" value="30cbcb19-25ff-488c-aa42-a81e519411a3" />
				</node>
				
