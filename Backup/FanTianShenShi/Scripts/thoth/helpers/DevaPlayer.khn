local __util = require 'larian.util'

function SomaticSpellCheck()
    return HasSpellFlag(SpellFlags.Somatic) & (HasSpellFlag(SpellFlags.Spell) | NonSpellMetamagicAbilities())
end

function CharacterLevelGreaterThanTarget()
    return ConditionResult(context.Source.Level >= context.Target.Level, {ConditionError("IsNotCharacterLevelGreaterThan")})
end

function DevaStage1(entity)
    entity = entity or context.Source
    return ConditionResult(entity.Level < 6, {ConditionError("IsNotCharacterLevelGreaterThan")})
end

function DevaStage2(entity)
    entity = entity or context.Source
    return ConditionResult(entity.Level >= 6 and entity.Level < 12)
end

function DevaStage3(entity)
    entity = entity or context.Source
    return ConditionResult(entity.Level >= 12, {ConditionError("IsNotCharacterLevelGreaterThan")})
end


function HasHigherPriorityExtraAttackQueued(status, entity)
    local entity = entity or context.Target
    local eaQueuedStatuses = {'EXTRA_ATTACK_5_Q'
        , 'EXTRA_ATTACK_4_Q'
        , 'EXTRA_ATTACK_3_Q'
        , 'EXTRA_ATTACK_2_Q'
        , 'EXTRA_ATTACK_Q'
        , 'EXTRA_ATTACK_WAR_MAGIC_Q'
        , 'MAG_MARTIAL_EXERTION_Q'
        , 'WILDSTRIKE_EXTRA_ATTACK_Q'
        , 'STALKERS_FLURRY_Q'
        , 'EXTRA_ATTACK_THIRSTING_BLADE_Q'
        , 'COMMANDERS_STRIKE_Q_D10'
        , 'COMMANDERS_STRIKE_Q_D8'
        , 'WILDSTRIKE_2_EXTRA_ATTACK_Q'
        , 'EXTRA_ATTACK_WAR_PRIEST_Q'
    }
    for i,v in ipairs(eaQueuedStatuses) do
        if (v == status) then
            return ConditionResult(false)
        end
        if HasStatus(v, entity, context.Source, false).Result then
            return ConditionResult(true)
        end
    end
    return ConditionResult(false)
end

function DistantTouchATTACKCheck()
    return HasStringInSpellRoll('Attack(AttackType.MeleeWeaponAttack)')
end

function IsDevaPlayerATTACKFULL(entity)
    local entity = entity or context.Source
    return ConditionResult(GetStatusDuration('DevaPlayer_GODHEAT', entity) >= 5)
end