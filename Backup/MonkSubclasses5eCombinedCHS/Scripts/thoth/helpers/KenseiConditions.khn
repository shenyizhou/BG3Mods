    local entity = entity or context.Source
	local result = Is5eKenseiWeapon(GetItemInEquipmentSlot(EquipmentSlot.MeleeMainHand, entity), entity) 
	
	return ConditionResult(result.Result, {ConditionError("HasNotKenseiMeleeWeaponInHand")})
		
end

