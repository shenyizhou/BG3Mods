	local result = Is5eKenseiWeapon(GetItemInEquipmentSlot(EquipmentSlot.MeleeOffHand, entity), entity)
	
	return ConditionResult(result.Result, {ConditionError("HasNotKenseiMeleeWeaponInHand")})
		
