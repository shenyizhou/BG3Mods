    local entity = entity or context.Source
	local result = Is5eKenseiWeapon(GetItemInEquipmentSlot(EquipmentSlot.RangedMainHand, entity), entity) | Is5eKenseiWeapon(GetItemInEquipmentSlot(EquipmentSlot.RangedOffHand, entity), entity)
	
	return ConditionResult(result.Result, {ConditionError("HasNotKenseiRangedWeaponInHand")})
		
end

function Has5eKenseiMainRangedWeaponEquipped(entity)
    local entity = entity or context.Source
	local result = Is5eKenseiWeapon(GetItemInEquipmentSlot(EquipmentSlot.RangedMainHand, entity), entity) 
	
	return ConditionResult(result.Result, {ConditionError("HasNotKenseiRangedWeaponInHand")})
		
end

function Has5eKenseiOffRangedWeaponEquipped(entity)
    local entity = entity or context.Source
	local result = Is5eKenseiWeapon(GetItemInEquipmentSlot(EquipmentSlot.RangedOffHand, entity), entity)
	
	return ConditionResult(result.Result, {ConditionError("HasNotKenseiRangedWeaponInHand")})
		
end

function KIs5eMeleeUnarmedAttack()
    local result = IsMeleeUnarmedAttack() & ~SpellTypeIs(SpellType.Throw)
	
    return ConditionResult(result.Result)
	
end

function Has5eKenseiParryWeapon(entity)
	local entity = entity or context.Target
	local result =  Has5eKenseiMeleeWeaponEquipped(entity) & Has5eKenseiParryStatus(entity)
		
    return ConditionResult(result.Result)
	
end

function Has5eKenseiParryStatus(entity)
	local entity = entity or context.Target
	local result = HasStatus('AGILE_PARRY_WEAPON',GetItemInEquipmentSlot(EquipmentSlot.MeleeMainHand, entity)) | HasStatus('AGILE_PARRY_WEAPON',GetItemInEquipmentSlot(EquipmentSlot.MeleeOffHand, entity)) 
	
    return ConditionResult(result.Result)

end

function Is5eKenseiWeaponAttack(entity)
	local entity = entity or context.Source
    local attackWeapon = GetAttackWeapon(entity)
	
    if attackWeapon.IsValid then
        return Is5eKenseiWeapon(attackWeapon)
    else
        return Is5eKenseiWeapon(context.HitDescription.ThrownObject)
    end

end

function KIsThrowAttackRoll()
    local res = IsUnarmedAttack() & SpellTypeIs(SpellType.Throw)
    return ConditionResult(res.Result)
end

function CanSharpenActiveWeapon(entity)
    local entity = entity or context.Target
	local resultWeaponMain = HasStatus('SHARPEN_THE_BLADE_MAINHAND', entity) & Is5eKenseiWeapon(GetActiveWeapon(entity, true), entity) & IsKenseNonmagical(GetActiveWeapon(entity, true))
	local resultWeaponOff = HasStatus('SHARPEN_THE_BLADE_OFFHAND', entity) & Is5eKenseiWeapon(GetActiveWeapon(entity, false), entity) & IsKenseNonmagical(GetActiveWeapon(entity, false))
	local result = resultWeaponMain | resultWeaponOff 	
	
    return ConditionResult(result.Result, {ConditionError("CanNotSharepenActiveWeapon")})
	
end   

function IsKenseNonmagical(weapon)
	local weapon = weapon
	
	return ~HasWeaponProperty(WeaponProperties.Magical, weapon) | HasStatus('KENSEI_MAGIC_WEAPON', weapon)
	
end

function IsSharpenedBladeAttack1(entity)
	local entity = entity or context.Source
    local attackWeapon = GetAttackWeapon(entity)
	
    if attackWeapon.IsValid then
        return HasStatus('SHARPEN_THE_BLADE_WEAPON1', attackWeapon, entity)
    else
        return HasStatus('SHARPEN_THE_BLADE_WEAPON1', context.HitDescription.ThrownObject, entity)
    end

end

function IsSharpenedBladeAttack2(entity)
	local entity = entity or context.Source
    local attackWeapon = GetAttackWeapon(entity)
	
    if attackWeapon.IsValid then
        return HasStatus('SHARPEN_THE_BLADE_WEAPON2', attackWeapon, entity)
    else
        return HasStatus('SHARPEN_THE_BLADE_WEAPON2', context.HitDescription.ThrownObject, entity)
    end

end

function IsSharpenedBladeAttack3(entity)
	local entity = entity or context.Source
    local attackWeapon = GetAttackWeapon(entity)
	
    if attackWeapon.IsValid then
        return HasStatus('SHARPEN_THE_BLADE_WEAPON3', attackWeapon, entity)
    else
        return HasStatus('SHARPEN_THE_BLADE_WEAPON3', context.HitDescription.ThrownObject, entity)
    end

end

function IsKenseiMonkWeaponAttack()
    local attackWeapon = GetAttackWeapon(context.Source)
    if attackWeapon.IsValid then
        return Is5eKenseiWeapon(attackWeapon) | ~(HasWeaponProperty(WeaponProperties.Heavy, attackWeapon) | HasWeaponProperty(WeaponProperties.Twohanded, attackWeapon)) & IsProficientWith(context.Source, attackWeapon) 
    else
		return Is5eKenseiWeapon(context.HitDescription.ThrownObject) | IsUnarmedAttack()
    end
	
end	
	
function IsUnerringAccuracyAttack()
    local attackWeapon = GetAttackWeapon(context.Source)
    if attackWeapon.IsValid then
        return Is5eKenseiWeapon(attackWeapon) | ~(HasWeaponProperty(WeaponProperties.Heavy, attackWeapon) | HasWeaponProperty(WeaponProperties.Twohanded, attackWeapon)) & IsProficientWith(context.Source, attackWeapon) 
    else
		return Is5eKenseiWeapon(context.HitDescription.ThrownObject) | IsRangedUnarmedAttack()
    end
	
end
