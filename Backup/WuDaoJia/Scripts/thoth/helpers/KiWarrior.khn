function IsKaioken(entity)
    local entity = entity or context.Target
    
    kk1 = HasStatus('KW_Kaiokenx1', entity)
    kk2 = HasStatus('KW_Kaiokenx2', entity)
    kk3 = HasStatus('KW_Kaiokenx3', entity)
    kk4 = HasStatus('KW_Kaiokenx4', entity)
    kk5 = HasStatus('KW_Kaiokenx5', entity)
    kk10 = HasStatus('KW_Kaiokenx10', entity)
    
    return ConditionResult((kk1.Result | kk2.Result | kk3.Result | kk4.Result | kk5.Result | kk10.Result))
end

function GetKaiokenStrainCap(entity)
    local entity = entity or context.Target
    
    mastery = HasPassive('KW_KaiokenMastery', entity)
    
    if mastery.Result then
        return 10
    else
        return 5
    end
end

function KaiokenBlastRequirement(entity)
    local entity = entity or context.Target
    return ConditionResult(GetStatusDuration('KW_KaiokenStrain', entity) >= GetKaiokenStrainCap(entity))
end

function MaximumLowStackableKaioken(entity)
    local entity = entity or context.Target
    return ConditionResult(GetStatusDuration('KW_KaiokenStrain', entity) > GetKaiokenStrainCap(entity))
end

function GetKaiokenDC(entity,tier)
    local entity = entity or context.Target
    return math.max(1, 8 + math.floor(entity.Level /2) + tier)
end

function GetKaiokenSaveDC(entity)
    entity = entity or context.Target
    km1 = HasPassive('KW_KaiokenMastery', entity)
    kk1 = HasStatus('KW_Kaiokenx1', entity)
    kk2 = HasStatus('KW_Kaiokenx2', entity)
    kk3 = HasStatus('KW_Kaiokenx3', entity)
    kk4 = HasStatus('KW_Kaiokenx4', entity)
    kk5 = HasStatus('KW_Kaiokenx5', entity)
    kk10 = HasStatus('KW_Kaiokenx10', entity)
    
    if (kk1.Result and km1.Result) then
        return 0
    elseif kk1.Result then
        return GetKaiokenDC(entity,1)
    elseif kk2.Result then
        return GetKaiokenDC(entity,2)
    elseif kk3.Result then
        return GetKaiokenDC(entity,3)
    elseif kk4.Result then
        return GetKaiokenDC(entity,4)
    elseif kk4.Result then
        return GetKaiokenDC(entity,5)
    elseif kk10.Result then
        return GetKaiokenDC(entity,6)
    else 
        return GetKaiokenDC(entity,1)
    end
end

function IsSaiyan(entity)
    local entity = entity or context.Target
    return ConditionResult(HasStatus('KW_SSJ1',entity) | HasStatus('KW_SSJ2',entity) | HasStatus('KW_SSJ3',entity))
end