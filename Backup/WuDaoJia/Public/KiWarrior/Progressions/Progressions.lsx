  <region id="Progressions">
    <node id="root">
      <children>
        <node id="Progression"> 
                    <attribute id="AllowImprovement" type="bool" value="false" /> Whether your class get a feat at his level. Does not work for level 1.
                    <attribute id="Boosts" type="LSString" value="ActionResource(KW_Energy,12,0);ProficiencyBonus(SavingThrow,Strength);ProficiencyBonus(SavingThrow,Dexterity);Proficiency(LightArmor);Proficiency(MediumArmor);Proficiency(SimpleWeapons);Proficiency(MartialWeapons)" /> Adds resource, proficiency, etc.
                    <attribute id="Level" type="uint8" value="1" /> Class Level for this entry
                    <attribute id="Name" type="LSString" value="KiWarrior" /> Name of the class, keep it consistent with class description
                    <attribute id="PassivesAdded" type="LSString" value="KW_PIERCING_BYPASS_TECHNICAL;KW_FORCE_BYPASS_TECHNICAL;Monk_SoundSwitch;KW_MartialExpert_DexOverride;KW_MartialExpert;KW_MartialExpert_BonusStrike;KW_KI_REGEN_TURN;KW_KI_REGEN_END_COMBAT" /> most class features usually can be done with passives
                    <attribute id="PassivesRemoved" type="LSString" value="" />
                    <attribute id="ProgressionType" type="uint8" value="0" /> 0 means main class, 1 means subclass, 2 means race
                    <attribute id="Selectors" type="LSString" value="SelectSkills(1c52fd71-2453-4db2-8ffc-34ad1e023336,2);SelectAbilityBonus(b9149c8e-52c8-46e5-9cb6-fc39301c05fe,AbilityBonus,2,1);AddSpells(6d9fa1f7-a5c0-488c-9220-d4c8138256f1,KW_MartialExpert,,,AlwaysPrepared);AddSpells(f1053b95-fffa-4ebd-b527-abb325c69547);AddSpells(e16adbf8-a371-427b-8d1d-261ac70b1249,,,,AlwaysPrepared)" /> this is where you can have your class select spells from spell list, passive from passive list, and skill from skill list. Select ability bonus let you get the +2/+1 at CC
					<attribute id="TableUUID" type="guid" value="cbc5c4f1-7f41-42c7-9778-6c19b0c1bf28" /> Same UUID as the one in ClassDescriptions.lsx this refers to the entire table
                    <attribute id="UUID" type="guid" value="caa46d0b-d171-4840-9225-4fd42ea83750" /> a Unique UUID specificaly for this entry within the table
                </node>
