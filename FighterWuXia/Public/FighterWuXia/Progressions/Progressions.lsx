<?xml version="1.0" encoding="UTF-8"?>
<!-- FighterWuXia 武侠子职业进展配置文件 -->
<!-- 定义战士职业的武侠专精子职业的等级进展和能力获得 -->
<save>
    <!-- 文件格式版本信息 -->
    <version major="4" minor="0" revision="9" build="328"/>
    <!-- 进展区域：包含所有职业和子职业的进展定义 -->
    <region id="Progressions">
        <node id="root">
            <children>
                <!-- 战士职业3级进展：子职业选择 -->
                <node id="Progression">
                    <!-- 是否允许改进：false表示不允许玩家自定义修改 -->
                    <attribute id="AllowImprovement" type="bool" value="false"/>
                    <!-- 等级：3级时触发此进展 -->
                    <attribute id="Level" type="uint8" value="3"/>
                    <!-- 职业名称：战士 -->
                    <attribute id="Name" type="LSString" value="Fighter"/>
                    <!-- 进展类型：0表示主职业进展 -->
                    <attribute id="ProgressionType" type="uint8" value="0"/>
                    <!-- 进展表UUID：关联到战士职业的进展表 -->
                    <attribute id="TableUUID" type="guid" value="721dfac3-92d4-41f5-b773-b7072a86232f"/>
                    <!-- 此进展的唯一标识符 -->
                    <attribute id="UUID" type="guid" value="a1b2c3d4-e5f6-7a8b-9c0d-1e2f3a4b5c6d"/>
                    <children>
                        <!-- 子职业列表：定义战士可选择的子职业 -->
                        <node id="SubClasses">
                            <children>
                                <node id="SubClass">
                                    <attribute id="Object" type="guid" value="f1e2d3c4-b5a6-9c8d-7e0f-6a5b4c3d2e1f"/>
                                </node>
                            </children>
                        </node>
                    </children>
                </node>

                <!-- 武侠子职业3级进展：大金刚神力 -->
                <node id="Progression">
                    <!-- 等级：3级时获得此能力 -->
                    <attribute id="Level" type="uint8" value="3"/>
                    <!-- 子职业名称：武侠 -->
                    <attribute id="Name" type="LSString" value="WuXia"/>
                    <!-- 添加的被动技能：大金刚神力 -->
                    <attribute id="PassivesAdded" type="LSString" value="WuXia_DaJinGangShenLi"/>
                    <!-- 进展类型：1表示子职业进展 -->
                    <attribute id="ProgressionType" type="uint8" value="1"/>
                    <!-- 进展表UUID：关联到武侠子职业的进展表 -->
                    <attribute id="TableUUID" type="guid" value="c1d2e3f4-5a6b-7c8d-9e0f-1a2b3c4d5e6f"/>
                    <!-- 此进展的唯一标识符 -->
                    <attribute id="UUID" type="guid" value="b2c3d4e5-f6a7-8b9c-0d1e-2f3a4b5c6d7e"/>
                </node>

                <!-- 武侠子职业5级进展：鹰眼 -->
                <node id="Progression">
                    <!-- 等级：5级时获得此能力 -->
                    <attribute id="Level" type="uint8" value="5"/>
                    <!-- 子职业名称：武侠 -->
                    <attribute id="Name" type="LSString" value="WuXia"/>
                    <!-- 添加的被动技能：鹰眼 -->
                    <attribute id="PassivesAdded" type="LSString" value="WuXia_YingYan"/>
                    <!-- 进展类型：1表示子职业进展 -->
                    <attribute id="ProgressionType" type="uint8" value="1"/>
                    <!-- 进展表UUID：关联到武侠子职业的进展表 -->
                    <attribute id="TableUUID" type="guid" value="c1d2e3f4-5a6b-7c8d-9e0f-1a2b3c4d5e6f"/>
                    <!-- 此进展的唯一标识符 -->
                    <attribute id="UUID" type="guid" value="c3d4e5f6-a7b8-9c0d-1e2f-3a4b5c6d7e8f"/>
                </node>

                <!-- 武侠子职业7级进展：六脉神剑 -->
                <node id="Progression">
                    <!-- 等级：7级时获得此能力 -->
                    <attribute id="Level" type="uint8" value="7"/>
                    <!-- 子职业名称：武侠 -->
                    <attribute id="Name" type="LSString" value="WuXia"/>
                    <!-- 添加的法术：六脉神剑相关技能 -->
                    <attribute id="Spells" type="LSString" value="WuXia_ShaoShangJian;WuXia_ShangYangJian;WuXia_ZhongChongJian;WuXia_GuanChongJian;WuXia_ShaoChongJian;WuXia_ShaoZeJian;WuXia_LiuMaiShenJian"/>
                    <!-- 进展类型：1表示子职业进展 -->
                    <attribute id="ProgressionType" type="uint8" value="1"/>
                    <!-- 进展表UUID：关联到武侠子职业的进展表 -->
                    <attribute id="TableUUID" type="guid" value="c1d2e3f4-5a6b-7c8d-9e0f-1a2b3c4d5e6f"/>
                    <!-- 此进展的唯一标识符 -->
                    <attribute id="UUID" type="guid" value="d4e5f6a7-b8c9-0d1e-2f3a-4b5c6d7e8f9a"/>
                </node>
            </children>
        </node>
    </region>
</save>